            "spacing": {
              "type": "string",
              "enum": [
                "small",
                "medium",
                "large"
              ]
            },
            "children": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "type",
            "children"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
