{
  "name": "@fastsprout/reacd",
  "version": "0.2.1",
  "private": false,
  "description": "A constrained, agent-driven UI contract and React renderer.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "schema/reacd.schema.json",
    "schema/generative.schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/reacd.schema.json",
    "./generative-schema.json": "./schema/generative.schema.json",
    "./generative": {
      "types": "./dist/generative.d.ts",
      "import": "./dist/generative.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./bootstrap": {
      "types": "./dist/renderer/bootstrap/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./adapter-runtime/core/*.js": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js"
    },
    "./adapter-runtime/schema/*.js": {
      "types": "./dist/schema/*.d.ts",
      "import": "./dist/schema/*.js"
    },
    "./adapter-runtime/components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./adapter-runtime/renderer/*.js": {
      "types": "./dist/renderer/*.d.ts",
      "import": "./dist/renderer/*.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.examples.config.ts --mode counter --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "schema": "tsx scripts/schema.ts",
    "schema:check": "tsx scripts/schema.ts --check",
    "validate": "tsx scripts/validate.ts",
    "policy": "tsx scripts/policy.ts",
    "test:package": "tsx scripts/package-check.ts",
    "docs:check": "node scripts/docs.mjs",
    "check": "node scripts/check.mjs",
    "release:verify": "tsx scripts/release-verify.ts",
    "release:pack": "tsx scripts/release-pack.ts",
    "release:publish": "tsx scripts/release-publish.ts",
    "release:registry": "tsx scripts/release-registry.ts",
    "lint:layers": "tsx scripts/lint-layers.ts",
    "example": "vite --config vite.examples.config.ts --host 127.0.0.1",
    "fixtures": "tsx scripts/fixtures.ts",
    "fixtures:check": "tsx scripts/fixtures.ts --check",
    "release:recover": "tsx scripts/release-recover.ts",
    "release:candidate": "tsx scripts/release-candidate.ts",
    "release:complete": "tsx scripts/release-complete.ts",
    "release:details": "tsx scripts/release-details.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "latest",
    "fast-check": "4.10.2",
    "jotai": "3.0.1",
    "jsdom": "latest",
    "oxc-parser": "0.156.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.5",
    "tailwindcss": "4.3.3",
    "tsx": "latest",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "@base-ui/react": "1.9.0",
    "@daypicker/react": "10.0.2",
    "@internationalized/date": "3.12.4",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-direction": "1.2.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tiptap/core": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@tiptap/suggestion": "3.32.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.5.0",
    "lucide-react": "1.63.0",
    "react-aria-components": "1.22.1",
    "tailwind-merge": "3.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FastSprout/Reacd.git"
  },
  "homepage": "https://reacd.dev/",
  "bugs": {
    "url": "https://github.com/FastSprout/Reacd/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@11.19.0",
  "peerDependencies": {
    "jotai": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
