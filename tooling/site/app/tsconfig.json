{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@fastsprout/reacd",
    "paths": {
      "@fastsprout/reacd-shadcn": [
        "../../../packages/shadcn/dist/shadcn/shadcn.adapter.d.ts"
      ],
      "@fastsprout/reacd-mui": [
        "../../../packages/mui/dist/mui/mui.adapter.d.ts"
      ],
      "@fastsprout/reacd/adapter-runtime/core/*": ["../../../dist/core/*"],
      "@fastsprout/reacd/adapter-runtime/schema/*": ["../../../dist/schema/*"],
      "@fastsprout/reacd/adapter-runtime/components/*": ["../../../dist/components/*"],
      "@fastsprout/reacd/adapter-runtime/renderer/*": ["../../../dist/renderer/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../../test-support/dom-matchers.d.ts"
  ]
}
