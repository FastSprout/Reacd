{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["react"]
  },
  "include": ["src"],
  "exclude": ["test-support", "src/**/*.test.*", "src/**/__tests__/**"]
}
